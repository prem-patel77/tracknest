@token = PASTE_TOKEN_HERE

### Register
POST http://localhost:5000/api/auth/register
Content-Type: application/json

{
  "name": "Prem",
  "email": "prem@test.com",
  "password": "password123"
}

### Login
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
  "email": "prem@test.com",
  "password": "password123"
}

### Me (protected)
GET http://localhost:5000/api/auth/me
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6MSwiaWF0IjoxNzkzMDM5MTIxLCJleHAiOjE3OTM2NDM5MjF9.h8E0QlULPUZJU41etRt7OBBKgXn-znF3___-MY-k_2M

### Create job
POST http://localhost:5000/api/jobs
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "company": "Shopify",
  "job_title": "Software Engineer Intern",
  "location": "Toronto, ON",
  "salary": "$30/hr",
  "status": "Applied",
  "deadline": "2026-11-15",
  "job_url": "https://www.shopify.com/careers",
  "notes": "Applied through the career page"
}

### Get all jobs
GET http://localhost:5000/api/jobs
Authorization: Bearer {{token}}

### Get jobs: search + status filter + sort + pagination (all optional)
# sortBy: company | deadline | created_at | status     order: asc | desc
GET http://localhost:5000/api/jobs?search=shop&status=Applied&sortBy=deadline&order=asc&page=1&limit=5
Authorization: Bearer {{token}}

### Summary totals for the dashboard cards (ignores search/filters)
GET http://localhost:5000/api/jobs/stats
Authorization: Bearer {{token}}

### Get one job
GET http://localhost:5000/api/jobs/1
Authorization: Bearer {{token}}

### Update job
PUT http://localhost:5000/api/jobs/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "company": "Shopify",
  "job_title": "Software Engineer Intern",
  "location": "Toronto, ON",
  "salary": "$30/hr",
  "status": "Interview",
  "deadline": "2026-11-15",
  "job_url": "https://www.shopify.com/careers",
  "notes": "Got an interview invite"
}

### Delete job
DELETE http://localhost:5000/api/jobs/1
Authorization: Bearer {{token}}





### Update profile (email change also needs currentPassword)
PUT http://localhost:5000/api/auth/profile
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "New Name",
  "email": "new@example.com",
  "currentPassword": "your-current-password"
}

### Change password
PUT http://localhost:5000/api/auth/password
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "currentPassword": "your-current-password",
  "newPassword": "a-new-password-123"
}
